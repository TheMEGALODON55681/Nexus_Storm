# ============================================================
# Knowledge STORM — Secrets Template
# ------------------------------------------------------------
# 1. Copy this file:  cp secrets.toml.example secrets.toml
# 2. Fill in your real API keys below
# 3. NEVER commit secrets.toml — it's listed in .gitignore
# ============================================================

# -------- REQUIRED: Google Gemini --------
# Free at: https://aistudio.google.com  (no credit card needed)
GOOGLE_API_KEY = "your_gemini_api_key_here"


# -------- OPTIONAL: OpenAI (only if using GPT scripts) --------
# OPENAI_API_KEY = "your_openai_api_key_here"
# OPENAI_API_TYPE = "openai"


# -------- OPTIONAL: Azure OpenAI --------
# AZURE_API_KEY = "your_azure_api_key_here"
# AZURE_API_BASE = "https://your-resource.openai.azure.com/"
# AZURE_API_VERSION = "2024-02-15-preview"


# -------- OPTIONAL: Embedding provider (for Co-STORM) --------
# ENCODER_API_TYPE = "openai"


# -------- OPTIONAL: Alternative search engines --------
# DuckDuckGo (default) is free and requires no key.
# Add these only if you want to use a different retriever:

# BING_SEARCH_API_KEY = "your_bing_api_key_here"
# YDC_API_KEY         = "your_you_dot_com_api_key_here"
# BRAVE_API_KEY       = "your_brave_search_api_key_here"
# SERPER_API_KEY      = "your_serper_api_key_here"
# TAVILY_API_KEY      = "your_tavily_api_key_here"
